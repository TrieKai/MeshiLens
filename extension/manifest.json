{
  "manifest_version": 3,
  "name": "MeshiLens — Tabelog for Maps",
  "version": "0.6.1",
  "description": "在 Google Maps 顯示 Tabelog、百名店與 Michelin 資訊，並比較日本美食行程候選店。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://meshilens.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.jp/maps/*",
        "https://maps.google.com/*"
      ],
      "js": ["category.js", "maps.js", "japan.js", "settings.js", "timeline.js", "advice.js", "similar.js", "popularity.js", "review_insights.js", "cache.js", "ui_mode.js", "list_badges.js", "runtime.js", "planner.js", "planner_store.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MeshiLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "planner.html"
  }
}
