<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ml_page"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ml_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/MeshiLens.Body"
            android:text="@string/main_subtitle"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/main_status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ml_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_status_body"
                style="@style/MeshiLens.Body" />

            <TextView
                android:id="@+id/main_open_accessibility"
                style="@style/MeshiLens.Button"
                android:layout_marginTop="14dp"
                android:text="@string/main_open_accessibility" />

            <TextView
                style="@style/MeshiLens.Caption"
                android:layout_marginTop="14dp"
                android:text="@string/main_restricted_hint" />

            <TextView
                android:id="@+id/main_open_app_info"
                style="@style/MeshiLens.Button.Outline"
                android:layout_marginTop="10dp"
                android:text="@string/main_open_app_info" />
        </LinearLayout>

        <TextView
            style="@style/MeshiLens.SectionTitle"
            android:text="@string/main_how_title" />

        <TextView
            style="@style/MeshiLens.Body"
            android:text="@string/main_how_body" />

        <TextView
            style="@style/MeshiLens.SectionTitle"
            android:text="@string/main_share_title" />

        <TextView
            style="@style/MeshiLens.Body"
            android:text="@string/main_share_body" />

        <TextView
            android:id="@+id/main_open_maps"
            style="@style/MeshiLens.Button.Outline"
            android:layout_marginTop="12dp"
            android:text="@string/main_open_maps" />

        <TextView
            style="@style/MeshiLens.SectionTitle"
            android:text="@string/main_privacy_title" />

        <TextView
            style="@style/MeshiLens.Body"
            android:text="@string/main_privacy_body" />

        <TextView
            android:id="@+id/main_version"
            style="@style/MeshiLens.Caption"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
